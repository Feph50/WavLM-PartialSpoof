# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter Notebooks & Caches
.ipynb_checkpoints
.pytest_cache/

# Large Datasets & Media
*.wav
*.flac
*.mp3
*.npy
*.pt
*.pth
*.ckpt

# Exception: keep configs
!config/**/*.yaml

# Logs & Run folders (Ignore all run directories, keep empty folder structure via .gitkeep)
logs/**/run*/
logs/**/run*
logs/**/*.log
logs/**/*.txt
logs/**/*.yaml

# Always track .gitkeep files
!**/.gitkeep
